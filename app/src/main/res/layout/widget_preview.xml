<?xml version="1.0" encoding="utf-8"?>
<!-- Статичне прев'ю для списку віджетів: справжній вміст малює Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сьогодні"
        android:textColor="#FFB8BFC7"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:text="Доба · з 08:00"
        android:textColor="#FFF0937E"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Наступна доба: 29 серпня"
        android:textColor="#FFE2E2E6"
        android:textSize="12sp" />
</LinearLayout>
